{
  "openapi": "3.0.0",
  "info": {
    "title": "Payment Service API",
    "version": "1.0.0",
    "description": "Handles payment processing, transactions, and refunds"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health check endpoint",
        "description": "Returns service health status",
        "tags": ["Health"],
        "responses": {
          "200": { "description": "Service is healthy" }
        }
      }
    },
    "/api/v1/payments": {
      "post": {
        "summary": "Process payment",
        "description": "Processes a new payment transaction",
        "tags": ["Payments"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Payment processed successfully" }
        }
      },
      "get": {
        "summary": "List payments",
        "description": "Retrieves payment history for authenticated user",
        "tags": ["Payments"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Payment list retrieved" }
        }
      }
    },
    "/api/v1/payments/{id}": {
      "get": {
        "summary": "Get payment details",
        "description": "Retrieves details of a specific payment",
        "tags": ["Payments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Payment details retrieved" }
        }
      }
    },
    "/api/v1/refunds": {
      "post": {
        "summary": "Process refund",
        "description": "Initiates a refund for a payment",
        "tags": ["Refunds"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Refund processed successfully" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}

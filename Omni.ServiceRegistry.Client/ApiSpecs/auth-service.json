{
  "openapi": "3.0.0",
  "info": {
    "title": "Auth Service API",
    "version": "1.0.0",
    "description": "Handles authentication, authorization, and user management"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health check endpoint",
        "description": "Returns service health status",
        "tags": ["Health"],
        "responses": {
          "200": { "description": "Service is healthy" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "User login",
        "description": "Authenticates user and returns JWT token",
        "tags": ["Authentication"],
        "responses": {
          "200": { "description": "Login successful" }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Refresh token",
        "description": "Refreshes JWT access token",
        "tags": ["Authentication"],
        "responses": {
          "200": { "description": "Token refreshed" }
        }
      }
    },
    "/api/v1/users": {
      "post": {
        "summary": "Create user",
        "description": "Registers a new user account",
        "tags": ["Users"],
        "responses": {
          "201": { "description": "User created" }
        }
      }
    },
    "/api/v1/users/{id}/permissions": {
      "get": {
        "summary": "Get user permissions",
        "description": "Retrieves permissions for specific user",
        "tags": ["Authorization"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Permissions retrieved" }
        }
      }
    },
    "/api/v1/roles": {
      "get": {
        "summary": "List roles",
        "description": "Retrieves available user roles",
        "tags": ["Authorization"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Role list retrieved" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}

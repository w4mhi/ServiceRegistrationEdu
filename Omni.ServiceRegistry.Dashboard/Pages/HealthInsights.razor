@page "/insights"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Web
@using Omni.ServiceRegistry.Dashboard.DTOs
@using Omni.ServiceRegistry.Dashboard.Services
@inject HealthInsightsApiClient InsightsClient
@inject ILogger<HealthInsights> Logger
@inject IJSRuntime JSRuntime

<PageTitle>Health Insights</PageTitle>

<div class="insights-container">
    <div class="page-header-modern">
        <h1 class="page-title-modern">✨🤖 AI Health Insights</h1>
        <button class="btn-refresh-top" @onclick="RefreshInsights">
            <i class="bi bi-arrow-clockwise"></i>
            <span>Refresh</span>
        </button>
    </div>
    <p class="text-muted" style="margin-bottom: 1.5rem;">LLM-powered analysis of service health patterns and anomalies</p>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading insights...</span>
            </div>
            <p class="mt-3">Loading recent insights...</p>
        </div>
    }
    else if (insights.Count == 0)
    {
        <div class="alert alert-info">
            <h5>📊 No insights available yet</h5>
            <p class="mb-0">
                Trigger analysis from the monitoring dashboard to generate AI-powered health insights.
                The system will analyze service health patterns, correlations, and historical data.
            </p>
        </div>
    }
    else
    {
        <div class="insights-stats mb-4">
            <div class="stat-card">
                <div class="stat-value">@insights.Count</div>
                <div class="stat-label">Total Insights</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@insights.Count(i => i.AnalysisStatus == "Completed")</div>
                <div class="stat-label">Completed</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@insights.Count(i => i.AnalysisStatus == "Failed")</div>
                <div class="stat-label">Failed</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@avgTokens</div>
                <div class="stat-label">Avg Tokens</div>
            </div>
        </div>

        <div class="insights-list">
            @foreach (var serviceGroup in insights.OrderByDescending(i => i.GeneratedAt).GroupBy(i => i.ServiceName))
            {
                string serviceName = serviceGroup.Key;
                int insightCount = serviceGroup.Count();
                HealthInsightDto latestInsight = serviceGroup.First();
                bool isExpanded = expandedGroups.Contains(serviceName);
                
                <div class="insight-group mb-3" @key="serviceName">
                    <div class="insight-group-header @GetInsightSeverityClass(latestInsight)" 
                         @onclick="@(() => ToggleGroup(serviceName))"
                         style="cursor: pointer; padding: 1rem; border-radius: 8px; border: 1px solid #dee2e6;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 style="margin: 0;">
                                    <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right") collapse-icon"></i>
                                    @serviceName
                                </h5>
                                <small class="text-muted">@insightCount insight(s) · Latest: @latestInsight.GeneratedAt.ToString("MMM dd, HH:mm")</small>
                            </div>
                            <div>
                                <span class="badge @GetTriggerBadgeClass(latestInsight.TriggerType)">
                                    @latestInsight.TriggerType
                                </span>
                                <span class="badge @GetStatusBadgeClass(latestInsight.AnalysisStatus)">
                                    @latestInsight.AnalysisStatus
                                </span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="collapse-content @(isExpanded ? "show" : "")">
                        @foreach (HealthInsightDto insight in serviceGroup.OrderByDescending(i => i.GeneratedAt))
                        {
                            <div class="insight-card @GetInsightSeverityClass(insight)" style="margin-top: 0.5rem;">                
                                <div class="insight-header">
                                    <div class="insight-title">
                                        <span class="badge @GetTriggerBadgeClass(insight.TriggerType)">
                                            @insight.TriggerType
                                        </span>
                                        <span class="badge @GetStatusBadgeClass(insight.AnalysisStatus)">
                                            @insight.AnalysisStatus
                                        </span>
                                    </div>
                                    <div class="insight-meta">
                                        <small class="text-muted">
                                            @insight.GeneratedAt.ToString("MMM dd, yyyy HH:mm:ss") UTC
                                            · @insight.LlmModel · @insight.TokensUsed tokens · @insight.ProcessingTimeMs ms
                                        </small>
                                    </div>
                                </div>

                                @if (insight.AnalysisStatus == "Completed")
                                {
                                    <div class="insight-body">
                            <div class="insight-section" style="margin-bottom: 0.5rem;">
                                <strong>📋 Summary:</strong> @insight.Summary
                            </div>

                            @if (insight.RootCauses.Count > 0)
                            {
                                <div class="insight-section" style="margin-bottom: 0.5rem;">
                                    <strong>🔍 Root Causes:</strong><br />
                                    @foreach (string cause in insight.RootCauses)
                                    {
                                        <span>• @cause<br /></span>
                                    }
                                </div>
                            }

                            @if (insight.CorrelatedServices.Count > 0)
                            {
                                <div class="insight-section" style="margin-bottom: 0.5rem;">
                                    <strong>🔗 Correlated Services:</strong><br />
                                    @foreach (CorrelatedServiceDto correlated in insight.CorrelatedServices)
                                    {
                                        <span>• <strong>@correlated.Service:</strong> @correlated.Impact<br /></span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(insight.HistoricalContext))
                            {
                                <div class="insight-section" style="margin-bottom: 0.5rem;">
                                    <strong>📊 Historical Context:</strong> @insight.HistoricalContext
                                </div>
                            }

                            @if (insight.RecommendedActions.Count > 0)
                            {
                                <div class="insight-section" style="margin-bottom: 0.5rem;">
                                    <strong>💡 Recommended Actions:</strong><br />
                                    @foreach (string action in insight.RecommendedActions)
                                    {
                                        <span>• @action<br /></span>
                                    }
                                </div>
                            }
                                        </div>
                                    }
                                    else if (insight.AnalysisStatus == "Failed")
                                    {
                                        <div class="alert alert-danger mb-0">
                                            <strong>Error:</strong> @insight.ErrorMessage
                                        </div>
                                    }

                                    <div class="insight-footer">
                                        <small class="text-muted">
                                            Triggered by: @insight.TriggeredBy
                                        </small>
                                    </div>
                                </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<HealthInsightDto> insights = new();
    private bool isLoading = true;
    private int avgTokens = 0;
    private System.Threading.Timer? refreshTimer;
    private HashSet<string> expandedGroups = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadInsightsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload data every time we navigate to this page
        await LoadInsightsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {if (firstRender)
        {
            // Auto-refresh every 5 seconds to show new insights as they're created
            refreshTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadInsightsAsync();
                    StateHasChanged();
                });
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
    }

    private void ToggleGroup(string serviceName)
    {
        if (expandedGroups.Contains(serviceName))
        {
            expandedGroups.Remove(serviceName);
        }
        else
        {
            expandedGroups.Add(serviceName);
        }
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }

    private async Task RefreshInsights()
    {
        await LoadInsightsAsync();
    }

    private async Task LoadInsightsAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            Logger.LogInformation("LoadInsightsAsync started");

            insights = await InsightsClient.GetRecentInsightsAsync(50);
            
            Logger.LogInformation("Loaded {Count} insights from API", insights.Count);
            
            if (insights.Count > 0)
            {
                avgTokens = (int)insights.Where(i => i.TokensUsed > 0).Average(i => i.TokensUsed);
                Logger.LogInformation("First insight: {Status}, Generated: {Time}", 
                    insights[0].AnalysisStatus, insights[0].GeneratedAt);
            }
            else
            {
                Logger.LogWarning("No insights returned from API");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load insights");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            Logger.LogInformation("LoadInsightsAsync completed, isLoading={IsLoading}, insights count={Count}", 
                isLoading, insights.Count);
        }
    }

    private string GetInsightSeverityClass(HealthInsightDto insight)
    {
        if (insight.AnalysisStatus != "Completed")
        {
            return insight.AnalysisStatus switch
            {
                "Failed" => "insight-failed",
                "Processing" => "insight-processing",
                _ => ""
            };
        }

        // Completed insights: determine severity by content
        if (insight.RecommendedActions.Count > 0)
        {
            return "insight-warning"; // Yellow/orange for actionable issues
        }

        return "insight-completed"; // Green for informational only
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Completed" => "insight-completed",
            "Failed" => "insight-failed",
            "Processing" => "insight-processing",
            _ => ""
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-success",
            "Failed" => "bg-danger",
            "Processing" => "bg-warning",
            _ => "bg-secondary"
        };
    }

    private string GetTriggerBadgeClass(string triggerType)
    {
        return triggerType switch
        {
            "Manual" => "bg-primary",
            "Automatic" => "bg-info",
            _ => "bg-secondary"
        };
    }
}

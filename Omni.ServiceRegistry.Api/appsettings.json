{
  "DatabaseProvider": "Postgres",
  "ConnectionStrings": {
    "ServiceRegistry": "Host=localhost;Database=serviceregistry;Username=postgres;Password=postgres;Port=5432;Include Error Detail=true"
  },
  "HeartbeatMonitoring": {
    "CheckIntervalSeconds": 5,
    "DefaultHeartbeatTimeoutSeconds": 30,
    "DefaultMaxMissedHeartbeats": 5
  },
  "ServiceRestoration": {
    "QuickRestoreWindowHours": 168,
    "MinimumConsecutiveHeartbeats": 10,
    "QuickRestoreBadgeDisplayDays": 7,
    "FullRestoreBadgeDisplayDays": 14
  },
  "HealthInsights": {
    "BatchAnalysisIntervalHours": 24,
    "AnalysisWindowHours": 48,
    "ManualTriggerMaxWindowHours": 168,
    "MinEventsForAnalysis": 3,
    "MinHeartbeatsForAnalysis": 3,
    "MaxConcurrentAnalyses": 2,
    "CacheResultsHours": 0,
    "ClientCooldownSeconds": 60,
    "ServerRateLimitPerMinute": 1,
    "EnableAutomaticAIAnalysis": false,
    "OllamaBaseUrl": "http://localhost:11434",
    "OllamaModel": "phi4",
    "MaxTokens": 4500,
    "Temperature": 0.7,
    "SystemPrompt": "You are a service health analyst for a microservices platform. Analyze service health and provide: 1) Brief incident summary (1-2 sentences), 2) Top 3 root causes, 3) Related service impact, 4) Historical insights (1 sentence), 5) Top 3 recommended actions. Output MUST be valid JSON: {\"summary\": \"...\", \"rootCauses\": [\"...\"], \"correlatedServices\": [{\"service\": \"...\", \"impact\": \"...\"}], \"historicalContext\": \"...\", \"recommendedActions\": [\"...\"]}. Be concise and technical."
  },
  "RateLimiting": {
    "Heartbeat": {
      "PermitLimit": 200,
      "WindowSeconds": 1,
      "QueueLimit": 50
    },
    "Registration": {
      "PermitLimit": 10,
      "WindowMinutes": 1,
      "SegmentsPerWindow": 6,
      "QueueLimit": 5
    },
    "Restoration": {
      "PermitLimit": 5,
      "WindowHours": 1,
      "QueueLimit": 2
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "https://localhost:5001",
      "http://localhost:8080",
      "http://localhost:8082"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Omni.ServiceRegistry": "Information"
    }
  },
  "AllowedHosts": "*"
}

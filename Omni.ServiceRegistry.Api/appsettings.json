{
  "DatabaseProvider": "Postgres",
  "ConnectionStrings": {
    "ServiceRegistry": "Host=localhost;Database=serviceregistry;Username=postgres;Password=postgres;Port=5432"
  },
  "HeartbeatMonitoring": {
    "CheckIntervalSeconds": 5,
    "DefaultHeartbeatTimeoutSeconds": 30,
    "DefaultMaxMissedHeartbeats": 5
  },
  "ServiceRestoration": {
    "QuickRestoreWindowHours": 168,
    "MinimumConsecutiveHeartbeats": 10,
    "QuickRestoreBadgeDisplayDays": 7,
    "FullRestoreBadgeDisplayDays": 14
  },
  "RateLimiting": {
    "Heartbeat": {
      "PermitLimit": 200,
      "WindowSeconds": 1,
      "QueueLimit": 50
    },
    "Registration": {
      "PermitLimit": 10,
      "WindowMinutes": 1,
      "SegmentsPerWindow": 6,
      "QueueLimit": 5
    },
    "Restoration": {
      "PermitLimit": 5,
      "WindowHours": 1,
      "QueueLimit": 2
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "https://localhost:5001",
      "http://localhost:8080",
      "http://localhost:8082"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Omni.ServiceRegistry": "Information"
    }
  },
  "AllowedHosts": "*"
}

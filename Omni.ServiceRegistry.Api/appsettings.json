{
  "DatabaseProvider": "Postgres",
  "ConnectionStrings": {
    "ServiceRegistry": "Host=localhost;Database=serviceregistry;Username=postgres;Password=postgres;Port=5432"
  },
  "HeartbeatMonitoring": {
    "CheckIntervalSeconds": 5,
    "DefaultHeartbeatTimeoutSeconds": 30,
    "DefaultMaxMissedHeartbeats": 5
  },
  "RateLimiting": {
    "HeartbeatPermitLimit": 200,
    "HeartbeatWindowSeconds": 1,
    "RegistrationPermitLimit": 10,
    "RegistrationWindowMinutes": 1
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "https://localhost:5001",
      "http://localhost:8080",
      "http://localhost:8082"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Omni.ServiceRegistry": "Information"
    }
  },
  "AllowedHosts": "*"
}
